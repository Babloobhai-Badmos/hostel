{
  "name": "hostel",
  "version": "0.1.0",
  "private": true,
  "description": "Chaotic multiplayer hostel social-deduction game for LAN play",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "tunnel": "node scripts/tunnel.mjs",
    "sim": "tsx scripts/simClients.ts",
    "map": "tsx scripts/mapPreview.ts",
    "selftest": "tsx scripts/selftest.ts",
    "sprites": "node scripts/makeSprites.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "express": "^4.22.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
